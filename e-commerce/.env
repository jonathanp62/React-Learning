#
# In Vite, only variables prefixed with VITE_ are exposed to client code,
# so those keys will be undefined even if they exist in .env.
#
# https://vite.dev/guide/env-and-mode.html#env-files

VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin123
VITE_ADMIN_ROLE=READWRITE

VITE_USER_USERNAME=user
VITE_USER_PASSWORD=user123
VITE_USER_ROLE=READONLY
